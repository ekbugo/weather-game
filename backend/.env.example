# Database
DATABASE_URL="postgresql://username:password@localhost:5432/hurricane_forecast?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Cron Jobs (for automated score calculation)
CRON_SECRET="your-cron-secret-key-change-this-in-production"

# Server
PORT=3001
NODE_ENV=development

# Data directory for weather JSON files
DATA_DIR="./data"

# Email (SMTP) - for password reset emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Huracán Info <noreply@huracaninfo.com>"

# Frontend URL - used in password reset links
FRONTEND_URL="http://localhost:5173"
